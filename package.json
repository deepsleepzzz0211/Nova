{
  "name": "@posuiqianqiu/nova",
  "version": "0.1.0",
  "description": "CLI AI Agent built with Ink and React — streaming LLM chat with tool use in the terminal",
  "type": "module",
  "bin": {
    "nova": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:mutation": "stryker run",
    "test:live": "vitest run --config tests/live/vitest.live.config.ts",
    "test:smoke": "vitest run --config tests/smoke/vitest.smoke.config.ts",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "llm",
    "mcp",
    "ink",
    "coding-agent"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.30.2",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mozilla/readability": "^0.6.0",
    "ink": "^7.1.0",
    "ink-markdown": "^1.0.4",
    "jsdom": "^29.1.1",
    "openai": "^6.45.0",
    "react": "^19.2.7",
    "smol-toml": "^1.7.0",
    "tiktoken": "^1.0.22",
    "turndown": "^7.2.4",
    "undici": "^8.10.2"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/turndown": "^5.0.6",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/posuiqianqiu/nova.git"
  },
  "bugs": {
    "url": "https://github.com/posuiqianqiu/nova/issues"
  },
  "homepage": "https://github.com/posuiqianqiu/nova#readme"
}