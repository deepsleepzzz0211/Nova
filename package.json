{
  "name": "@posuiqianqiu/nova",
  "version": "0.1.2",
  "description": "CLI AI Agent built with Ink and React — streaming LLM chat with tool use in the terminal",
  "type": "module",
  "bin": {
    "nova": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:mutation": "stryker run",
    "test:live": "vitest run --config tests/live/vitest.live.config.ts",
    "test:smoke": "vitest run --config tests/smoke/vitest.smoke.config.ts",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "llm",
    "mcp",
    "ink",
    "coding-agent"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.30.2",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mozilla/readability": "^0.6.0",
    "ink": "^7.1.1",
    "ink-markdown": "^1.0.4",
    "jsdom": "^30.0.1",
    "openai": "^7.10.0",
    "react": "^19.2.8",
    "smol-toml": "^1.8.0",
    "tiktoken": "^1.0.22",
    "turndown": "^7.2.4",
    "undici": "^8.10.2"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/turndown": "^5.0.6",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^5.0.0"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepsleepzzz0211/Nova.git"
  },
  "bugs": {
    "url": "https://github.com/deepsleepzzz0211/Nova/issues"
  },
  "homepage": "https://github.com/deepsleepzzz0211/Nova#readme"
}
